# Copy to .env.production on the container host. Never commit the real file.
# Generate secrets with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# --- Supabase control-plane database (forge schema only) -------------------------------------
# Session pooler (port 5432), role forge_app.<project-ref>, TLS required. Copy host/region from the
# project's Connect panel; the password is the one you passed to deploy/supabase/bootstrap.sql.
SUPABASE_FORGE_DATABASE_URL=postgresql+psycopg://forge_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Public API hostname served by Caddy (DNS A/AAAA record must point at this host) ----------
API_DOMAIN=api.example.com

# --- Still required by the base compose file (local shop/lab/validation databases) ------------
POSTGRES_PASSWORD=
SHOP_DB_PASSWORD=
LAB_DB_PASSWORD=
FORGE_DB_PASSWORD=
FORGE_READER_DB_PASSWORD=
FORGE_REMEDIATOR_DB_PASSWORD=
SANDBOX_DB_PASSWORD=
SANDBOX_ADMIN_TOKEN=
FORGE_JWT_SECRET=
# user:role:password, comma separated. Use real passwords; roles: viewer, operator, approver, admin.
FORGE_BOOTSTRAP_USERS=

# --- Optional: LLM investigator (Gemini only) --------------------------------------------------
FORGE_DEFAULT_MODE=runbook
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Vercel project environment (set in Vercel, not here) --------------------------------------
# API_ORIGIN=https://api.example.com
