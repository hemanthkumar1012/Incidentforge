# Copy to .env and replace every change-me value. Never commit .env.
# All data is synthetic; these are local-only credentials. See docs/configuration.md.

# --- Postgres roles (one per component; see deploy/postgres/init.sh)
POSTGRES_PASSWORD=change-me-postgres
SHOP_DB_PASSWORD=change-me-shop
LAB_DB_PASSWORD=change-me-lab
FORGE_DB_PASSWORD=change-me-forge
FORGE_READER_DB_PASSWORD=change-me-forge-reader
FORGE_REMEDIATOR_DB_PASSWORD=change-me-forge-remediator
SANDBOX_DB_PASSWORD=change-me-sandbox

# --- Shared secrets for fault/admin hooks (production lab vs validation sandbox)
LAB_ADMIN_TOKEN=change-me-long-random-string
SANDBOX_ADMIN_TOKEN=change-me-another-long-random-string

# --- Control plane
# At least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FORGE_JWT_SECRET=change-me-at-least-32-characters-long-secret
# Demo users created on first start: name:role:password (password >= 12 chars).
FORGE_BOOTSTRAP_USERS=olivia:operator:change-me-operator,arun:approver:change-me-approver,vera:viewer:change-me-viewer,ada:admin:change-me-admin
# runbook (deterministic, no LLM) or llm (Gemini; needs GEMINI_API_KEY)
FORGE_DEFAULT_MODE=runbook
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DETECTOR_ENABLED=true

LOG_LEVEL=INFO
LOAD_RPS=3

# --- Evaluation runner (lab container): user:password of an operator and an approver
EVAL_OPERATOR=olivia:change-me-operator
EVAL_APPROVER=arun:change-me-approver
